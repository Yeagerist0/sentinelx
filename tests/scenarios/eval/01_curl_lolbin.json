    {"id":"e3","kind":"exec","host_id":"h1","boot_id":"b","pid":102,"ppid":100,"exe":"/usr/bin/chmod","args":"+x /tmp/sx_payload","path":"/tmp/sx_payload"},
    {"id":"e4","kind":"exec","host_id":"h1","boot_id":"b","pid":103,"ppid":100,"exe":"/tmp/sx_payload","args":"--beacon","path":"/tmp/sx_payload"}
